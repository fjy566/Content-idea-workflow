APP_NAME=Content Idea Workflow
HOST=127.0.0.1
PORT=8000
DATA_DIR=data
CRAWL_INTERVAL_MINUTES=30
# 单个数据源的默认超时时间；可在“数据源”页面为每个源单独调整（5-300 秒）
SOURCE_TIMEOUT_SECONDS=30
# 一轮采集的总超时时间；可在“任务”页面为手动采集单独调整（30-3600 秒）
CRAWL_ROUND_TIMEOUT_SECONDS=300
REQUEST_TIMEOUT_SECONDS=25
MAX_RESPONSE_BYTES=5000000
USER_AGENT=ContentIdeaWorkflow/0.1 (+local personal research tool)
# Set to 1 only when your DNS resolves public hosts to routable public IPs.
STRICT_SSRF_DNS=0

# Optional defaults. These can also be set in the web UI.
AI_CHAT_ENDPOINT=
AI_CHAT_API_KEY=
AI_CHAT_MODEL=
AI_IMAGE_ENDPOINT=
AI_IMAGE_API_KEY=
AI_IMAGE_MODEL=
IMAGE_SEARCH_PROVIDER=360
PREFERRED_KEYWORDS=
BLOCKED_KEYWORDS=
